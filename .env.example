PORT=5000
NODE_ENV=development

# --- Auth ---
# Must be at least 32 characters.
JWT_SECRET=
# Required in production. Comma-separated list of allowed origins.
CORS_ORIGIN=

# --- Storage provider (the switch) -------------------------------------------
# DATA_PROVIDER selects the data provider:
#   mongo  = MongoDB          (default) — needs MONGO_URI + DB_NAME below
#   sqlite = SQLite file      — needs nothing; a real query planner, no server
#   mysql  = MySQL / MariaDB  — needs a running server; see MYSQL_* below
#   json   = in-app JSON      — needs nothing; no indexes, slow on large data
DATA_PROVIDER=mongo

# --- MongoDB (used when DATA_PROVIDER=mongo) ---
MONGO_URI=
DB_NAME=annotator_db
# Optional: comma-separated DNS servers, e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=

# --- SQLite (used when DATA_PROVIDER=sqlite) ---
# Path to the database file. The parent directory is created on boot.
# The file is gitignored; delete it to start over.
SQLITE_FILE=storage/annotator.sqlite

# --- MySQL / MariaDB (used when DATA_PROVIDER=mysql) ---
# Either set MYSQL_URL, or the discrete MYSQL_* parts below. MYSQL_URL wins.
#   MYSQL_URL=mysql://user:password@127.0.0.1:3306/annotator_db
MYSQL_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=annotator_db
# Pooled connections. Keep this below the server's max_connections.
MYSQL_POOL_SIZE=10

# --- JSON store (used when DATA_PROVIDER=json) ---
# Directory that holds one JSON file per collection. Created on boot.
JSON_DATA_DIR=data/json
# true = flush every mutation to disk immediately (crash-safe, slower)
# false = batch writes (faster, risks losing the last few writes on a hard kill)
JSON_WRITE_THROUGH=true

# --- Optional: concurrency ---
MAX_CONCURRENT_IMPORTS=2
MAX_CONCURRENT_EXPORTS=4
MAX_QUEUE_SIZE=100
JOB_TIMEOUT_MS=600000
EXPORT_TIMEOUT_MS=60000
QUEUE_LOG_INTERVAL_MS=60000

# --- Optional: rate limiting (requests per minute; unset = sensible default) ---
RATE_LIMIT_GLOBAL=
RATE_LIMIT_AUTH=

# --- Media: image / video annotation (optional) ---------------------------------
# Uploaded images and videos are stored on the LOCAL FILESYSTEM, not in the
# database. The database holds only metadata (dimensions, checksum) and the
# annotation geometry. Files are served through an authenticated route, never
# as a static directory.
#
# MEDIA_ROOT lives under storage/, which is already gitignored.
MEDIA_ROOT=storage/media
# Max bytes per uploaded file. Uploads are buffered in memory before being
# written, so this is a memory cap as well as a disk cap.
MEDIA_MAX_UPLOAD_MB=100
# Max files per upload request.
MEDIA_MAX_FILES=50
# Decompression-bomb guard: reject images declaring more than this many pixels.
MEDIA_MAX_PIXELS=50000000
# Extension allow-lists (no dots, lower-case). The browser-supplied MIME type
# is not trusted; these lists are the authority.
MEDIA_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp,bmp,tif,tiff
MEDIA_VIDEO_EXTENSIONS=mp4,m4v,mov,webm,mkv,avi
# Max assets per dataset. 0 = unlimited.
MEDIA_MAX_ASSETS_PER_DATASET=0
